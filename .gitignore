# Dependencies
/node_modules/

# Frontend build and test output
/build/
/dist/
/dist-ssr/
/coverage/
/.vite/
*.tsbuildinfo

# Rust/Tauri output (also covered by src-tauri/.gitignore)
/src-tauri/target/
/src-tauri/gen/schemas/

# Locally exported installers and generated mobile icons
/dist-installers/
/src-tauri/icons/64x64.png
/src-tauri/icons/android/
/src-tauri/icons/ios/

# Downloaded native SDKs. Recreate with: bun run download:ndi-sdk
/sdk/ndi/

# Generated Bible data and SQLite journals
/data/rhema.db
/data/*.db-shm
/data/*.db-wal
/data/*.db-journal
/data/sources/*.json
/data/cross-refs/cross_references.txt
/data/cross-refs/cross-references.zip
/data/verses-for-embedding.json
/data/bg_temp/
/scripts/hymnals/.cache/

# Downloaded ML models and generated embeddings
/models/*
/embeddings/*

# Python environments and caches
/.venv/
**/__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.template
*.local

# Logs, crash dumps, and profiling output
/logs/
*.log
*.dmp
*.profraw
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and operating-system files
/.vscode/*
!/.vscode/extensions.json
/.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig

# Local agent and planning artifacts
/.superpowers/
/.docs/
/.planning/
/.claude/CLAUDE.md
/docs/superpowers/
/rhema-technical-plan-v3.4.md
/detailed-plan.md
/GHS-1-260.md
