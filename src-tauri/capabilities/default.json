{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "broadcast",
    "broadcast-alt"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "store:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "global-shortcut:allow-register"
  ]
}